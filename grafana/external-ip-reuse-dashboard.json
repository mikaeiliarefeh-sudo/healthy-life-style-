    "engine",
    "externalip",
    "capacity"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
