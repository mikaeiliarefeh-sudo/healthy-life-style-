      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(\ncount by (cluster, namespace, ip) (\n  count_over_time(\n    ( max by (cluster, namespace, ip, target_kind, target_name) (kube_customresource_external_ip_info{cluster=~\"$cluster\", namespace!=\"compute-reserve\", namespace=~\"$ns_filter\", target_kind!=\"\"}) )[$window:$step]\n  )\n)\n)",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "__auto",
          "exemplar": false
