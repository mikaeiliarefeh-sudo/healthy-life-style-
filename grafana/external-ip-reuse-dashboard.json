        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "IPs with ≥1 attachment",
      "description": "Denominator: distinct (cluster, namespace, ip) that were bound to at least one resource at some point during $window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
